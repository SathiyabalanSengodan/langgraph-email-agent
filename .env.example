# LLM: any OpenAI-compatible endpoint. Defaults to NVIDIA (https://build.nvidia.com).
NVIDIA_API_KEY=nvapi-your-key-here
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# To use OpenAI instead: remove NVIDIA_API_KEY, then set
# OPENAI_API_KEY=sk-your-key-here
# LLM_BASE_URL=
# LLM_MODEL=gpt-5-mini

# Optional: LangSmith tracing (https://smith.langchain.com)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_pt_your-key-here
LANGSMITH_PROJECT=langgraph-email-agent
# EU accounts: LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
